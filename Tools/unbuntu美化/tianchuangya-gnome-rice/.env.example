# tianchuangya-gnome-rice optional local environment
# Copy to .env.local and fill values on your own machine.
# Never commit .env.local or real tokens.

# Island Sync Gitee relay settings
ISLAND_SYNC_GITEE_OWNER="你的Gitee用户名"
ISLAND_SYNC_GITEE_REPO="你的仓库名"
ISLAND_SYNC_GITEE_TOKEN="你的Gitee私人令牌"

# Optional user-data backup encryption
TIANCHUANGYA_BACKUP_PASSWORD="换成你的强密码"

# Optional custom WeChat deb URL
# WECHAT_DEB_URL="https://example.com/WeChatLinux_x86_64.deb"
